#!/bin/sh
# Before every push: the same check as CI (.github/workflows/ci.yml), so a broken branch never leaves this machine:
# the typecheck, then the tests with 100% coverage. Takes a minute or two. Turn it on once per clone with:
#   git config core.hooksPath .githooks
# Skip it for one push (e.g. docs only) with:  git push --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

echo "pre-push: typecheck, tests and coverage..."
npm run --silent check

echo "pre-push: all checks passed."

{
  "name": "imperial-generals-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TypeScript port of the Imperial Generals combat engine and its browser client.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "preact": "10.29.8"
  }
}
